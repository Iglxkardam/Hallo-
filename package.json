{
  "name": "deutsch-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gamified 30-day German A1 trainer (Netzwerk neu A1 + Goethe A1)",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.mjs\" \"vite\"",
    "web": "vite",
    "api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/build-audio.mjs",
    "check": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
